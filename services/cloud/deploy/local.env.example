# Copy to local.env and fill for one-click build/push/deploy.
# local.env is gitignored — never commit real hosts, tokens, or private registry paths.
#
#   cp services/cloud/deploy/local.env.example services/cloud/deploy/local.env

# --- Container registry (private) ---
REGISTRY=your-registry.example.com
NAMESPACE=your-namespace
IMAGE_NAME=giteam-cloud
# Optional override; default = git short sha
# TAG=0.1.0
PLATFORM=linux/amd64

# --- Public cloud entry (used for PUBLIC_BASE_URL / QR) ---
PUBLIC_BASE_URL=http://127.0.0.1:8787

# --- Runtime secrets (cluster) ---
JWT_SECRET=change-me-jwt-secret-at-least-16-chars
ADMIN_TOKEN=change-me-admin-token
DATABASE_URL=postgres://giteam:giteam@giteam-cloud-postgres:5432/giteam_cloud

# Optional kubectl namespace
# KUBE_NAMESPACE=default
