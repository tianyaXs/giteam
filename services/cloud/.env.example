POSTGRES_USER=giteam
POSTGRES_PASSWORD=giteam
POSTGRES_DB=giteam_cloud
# docker compose gateway 使用服务名 postgres；本机 cargo run 请改为 127.0.0.1
DATABASE_URL=postgres://giteam:giteam@postgres:5432/giteam_cloud
JWT_SECRET=dev-jwt-secret-change-me-in-production
ADMIN_TOKEN=dev-admin-token-change-me-in-production
# 真机/公网入口写在本机 .env（gitignored），勿把真实 IP/域名提交进仓库
PUBLIC_BASE_URL=http://127.0.0.1:8787
LISTEN_ADDR=0.0.0.0:8787
STATIC_DIR=
