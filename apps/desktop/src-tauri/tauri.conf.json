{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Giteam",
  "mainBinaryName": "Giteam",
  "version": "0.2.43",
  "identifier": "io.giteam.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 720,
        "center": true,
        "maximized": false,
        "theme": "Dark",
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 25
        },
        "backgroundColor": "#1E1E1E",
        "devtools": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIxOEM1RTgzNTExNkJERjgKUldUNHZSWlJnMTZNSVJyWXdLTmRveE5VNlo1N1VjaWdyTlVOU1N6RXpvZ3M5dG5CNVJVZk91L1cK",
      "endpoints": [
        "https://github.com/tianyaXs/giteam/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
