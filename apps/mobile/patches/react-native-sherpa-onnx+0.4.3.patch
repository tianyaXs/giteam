diff --git a/node_modules/react-native-sherpa-onnx/android/src/main/cpp/include/ffmpeg/libavutil/refstruct.h b/node_modules/react-native-sherpa-onnx/android/src/main/cpp/include/ffmpeg/libavutil/refstruct.h
