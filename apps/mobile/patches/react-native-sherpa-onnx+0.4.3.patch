+/** Read transducer encoder ONNX metadata (matches sherpa CLI --model-type and X-ASR test_onnx.py). */
+std::string resolveTransducerOnnxModelType(const std::string& encoderPath) {
+    if (encoderPath.empty()) {
+        return "zipformer";
+    }
+
+#if SHERPA_ONNX_HAS_ORT_C_API
+    const OrtApi* ort = OrtGetApiBase()->GetApi(ORT_API_VERSION);
+    if (ort == nullptr) {
+        return "zipformer";
+    }
+
+    OrtEnv* env = nullptr;
+    OrtSessionOptions* sessionOptions = nullptr;
+    OrtSession* session = nullptr;
+    OrtModelMetadata* metadata = nullptr;
+    OrtAllocator* allocator = nullptr;
+
+    auto cleanup = [&]() {
+        if (metadata != nullptr) {
+            ort->ReleaseModelMetadata(metadata);
+            metadata = nullptr;
+        }
+        if (session != nullptr) {
+            ort->ReleaseSession(session);
+            session = nullptr;
+        }
+        if (sessionOptions != nullptr) {
+            ort->ReleaseSessionOptions(sessionOptions);
+            sessionOptions = nullptr;
+        }
+        if (env != nullptr) {
+            ort->ReleaseEnv(env);
+            env = nullptr;
+        }
+    };
+
+    if (ort->CreateEnv(ORT_LOGGING_LEVEL_WARNING, "sherpa_online_transducer", &env) != nullptr) {
+        return "zipformer";
+    }
+    if (ort->CreateSessionOptions(&sessionOptions) != nullptr) {
+        cleanup();
+        return "zipformer";
+    }
+    if (ort->CreateSession(env, encoderPath.c_str(), sessionOptions, &session) != nullptr) {
+        cleanup();
+        return "zipformer";
+    }
+    if (ort->SessionGetModelMetadata(session, &metadata) != nullptr) {
+        cleanup();
+        return "zipformer";
+    }
+    if (ort->GetAllocatorWithDefaultOptions(&allocator) != nullptr) {
+        cleanup();
+        return "zipformer";
+    }
+
+    char* value = nullptr;
+    std::string modelType = "zipformer";
+    if (ort->ModelMetadataLookupCustomMetadataMap(metadata, allocator, "model_type", &value) == nullptr &&
+        value != nullptr) {
+        modelType = value;
+        ort->AllocatorFree(allocator, value);
+    }
+
+    cleanup();
+
+    if (modelType == "zipformer2" || modelType == "zipformer" || modelType == "conformer" ||
+        modelType == "lstm" || modelType == "nemo_transducer") {
+        LOGO("Online transducer model_type=%s encoder=%s", modelType.c_str(), encoderPath.c_str());
+        return modelType;
+    }
+#endif
+
+    return "zipformer";
+}
+
