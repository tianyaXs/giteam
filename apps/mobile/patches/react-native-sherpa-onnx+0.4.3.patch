+ *     SherpaOnnxReadWave("./sherpa-onnx-whisper-tiny.en/test_wavs/0.wav");
+ * const SherpaOnnxOfflineStream *stream =
+ *     SherpaOnnxCreateOfflineStream(recognizer);
