+ *
+ * @code
+ * SherpaOnnxDestroyOfflineStreamResultJson(json);
+ * json = NULL;
+ * @endcode
+ */
+SHERPA_ONNX_API void SherpaOnnxDestroyOfflineStreamResultJson(const char *s);
