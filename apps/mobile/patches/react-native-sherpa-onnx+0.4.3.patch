+/** Download a release asset atomically without relying on the removed Project.exec API. */
+def downloadReleaseAsset = { String url, File destination, File workingDirectory ->
+  destination.parentFile.mkdirs()
+  if (destination.exists() && destination.length() > 0) {
+    println "[prebuilt] cache hit: ${destination}"
+    return
+  }
+  def partial = new File(destination.parentFile, "${destination.name}.part")
+  if (partial.exists()) partial.delete()
+  def command = [
+    'curl', '--fail', '--silent', '--show-error', '--location',
+    '--retry', '5', '--retry-all-errors', '--retry-delay', '2',
+    '--connect-timeout', '60', '--max-time', '900',
+    '--output', partial.absolutePath, url
+  ]
+  def process = new ProcessBuilder(command)
+      .directory(workingDirectory)
+      .redirectErrorStream(true)
+      .start()
+  def output = process.inputStream.getText('UTF-8')
+  def exitCode = process.waitFor()
+  if (exitCode != 0 || !partial.exists() || partial.length() == 0) {
+    if (partial.exists()) partial.delete()
+    throw new GradleException("Failed to download ${url} (curl exit=${exitCode})${output ? ': ' + output.trim() : ''}")
+  }
+  if (destination.exists()) destination.delete()
+  if (!partial.renameTo(destination)) {
+    throw new GradleException("Downloaded ${url}, but could not move ${partial} to ${destination}")
+  }
+}
