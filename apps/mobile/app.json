{
  "expo": {
    "name": "Giteam",
    "slug": "giteam-mobile",
    "version": "0.1.34",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon-light.png",
      "backgroundColor": "#FFFFFF",
      "resizeMode": "contain",
      "dark": {
        "image": "./assets/splash-icon-light.png",
        "backgroundColor": "#FFFFFF",
        "resizeMode": "contain"
      }
    },
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "newArchEnabled": true,
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "用于从系统相册选择包含二维码的图片。"
        }
      ]
    ],
    "android": {
      "package": "io.giteam.mobile",
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "splash": {
        "image": "./assets/splash-icon-light.png",
        "backgroundColor": "#FFFFFF",
        "resizeMode": "contain",
        "dark": {
          "image": "./assets/splash-icon-light.png",
          "backgroundColor": "#FFFFFF",
          "resizeMode": "contain"
        }
      }
    },
    "ios": {
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "用于从系统相册选择包含二维码的图片。",
        "NSLocalNetworkUsageDescription": "用于连接同一局域网内的 Giteam Desktop 控制服务。",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "extra": {
      "eas": {
        "projectId": "8ffa54af-2a88-4355-be06-5dd32ee1959c"
      }
    },
    "owner": "tianya_888"
  }
}
